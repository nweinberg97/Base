# Base runs locally with no API keys. Every variable here is optional.

# Where the SQLite database file lives (default: db/base.sqlite).
BASE_DB_PATH=db/base.sqlite

# The month the research engine plans for, 1-12 (default: the current month).
# Set this to reproduce a past run, e.g. BASE_REFERENCE_MONTH=10 for October.
BASE_REFERENCE_MONTH=

# The date the current weekly Base is for, YYYY-MM-DD (default: the Monday of the current week).
BASE_WEEK_OF=

# Port for `npm run dev` and `npm run preview` (default: 5173 / 4173).
PORT=

# Public URL the site is served from, used for canonical and Open Graph tags.
BASE_SITE_URL=http://localhost:4173

# Sub-path the site is served from, e.g. /Base for https://<user>.github.io/Base/ (default: none).
BASE_PATH=
